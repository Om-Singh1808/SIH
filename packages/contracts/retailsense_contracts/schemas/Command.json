{
  "additionalProperties": false,
  "description": "Cloud -> device instruction, piggybacked on IngestAck (HTTP) or cmd topic (MQTT).",
  "properties": {
    "command_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "ack_alert",
        "apply_config",
        "set_link",
        "set_scenario",
        "model_update",
        "ping"
      ],
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "created_ts": {
      "type": "number"
    }
  },
  "required": [
    "command_id",
    "device_id",
    "kind",
    "payload",
    "created_ts"
  ],
  "title": "Command",
  "type": "object",
  "$schema": "https://json-schema.org/draft-07/schema#"
}
