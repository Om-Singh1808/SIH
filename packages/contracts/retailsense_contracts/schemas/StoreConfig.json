          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "end": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
