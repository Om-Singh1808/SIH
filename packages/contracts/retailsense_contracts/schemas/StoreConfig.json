{
  "$defs": {
    "Anchor": {
      "description": "Which point of a track's bbox represents the person on the floor.",
      "enum": [
        "bottom_center",
        "center"
      ],
      "title": "Anchor",
      "type": "string"
    },
    "CameraConfig": {
      "additionalProperties": false,
      "properties": {
        "camera_id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "width": {
          "default": 640,
          "type": "integer"
        },
        "height": {
          "default": 360,
          "type": "integer"
        },
        "fps_sample": {
          "default": 4.0,
          "type": "number"
        },
        "detector": {
          "allOf": [
            {
              "$ref": "#/$defs/DetectorKind"
            }
          ],
          "default": "auto"
        },
        "anchor": {
          "allOf": [
            {
              "$ref": "#/$defs/Anchor"
            }
          ],
          "default": "bottom_center"
        },
        "shelf_scan_interval_s": {
          "default": 60.0,
          "type": "number"
        },
        "homography": {
          "anyOf": [
            {
              "$ref": "#/$defs/HomographyConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "preview_blur_people": {
          "default": true,
          "type": "boolean"
        },
        "loop_file": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "camera_id",
        "source",
        "width",
        "height",
        "fps_sample",
        "detector",
        "anchor",
        "shelf_scan_interval_s",
        "homography",
        "preview_blur_people",
        "loop_file"
      ],
      "title": "CameraConfig",
      "type": "object"
    },
    "Counter": {
      "additionalProperties": false,
      "properties": {
        "counter_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "queue_zone_id": {
          "type": "string"
        },
        "counter_line_id": {
          "type": "string"
        },
        "max_queue": {
          "default": 8,
          "type": "integer"
        },
        "default_service_s": {
          "default": 45.0,
          "type": "number"
        }
      },
      "required": [
        "counter_id",
        "name",
        "queue_zone_id",
        "counter_line_id",
        "max_queue",
        "default_service_s"
      ],
      "title": "Counter",
      "type": "object"
    },
    "DemoConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "clock_factor": {
          "default": 10.0,
          "type": "number"
        },
        "default_scenario": {
          "default": "baseline",
          "type": "string"
        },
        "start_time": {
          "default": "17:00",
          "type": "string"
        },
        "seed_history_days": {
          "default": 30,
          "type": "integer"
        },
        "auto_calibrate_first_scan": {
          "default": true,
          "type": "boolean"
        }
      },
      "title": "DemoConfig",
      "type": "object",
      "required": [
        "enabled",
        "clock_factor",
        "default_scenario",
        "start_time",
        "seed_history_days",
        "auto_calibrate_first_scan"
      ]
    },
    "DetectorKind": {
      "enum": [
        "auto",
        "synthetic",
        "onnx",
        "ultralytics",
        "fake"
      ],
      "title": "DetectorKind",
      "type": "string"
    },
    "DeviceConfig": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string"
        },
        "token": {
          "default": "demo-token",
          "type": "string"
        },
        "edge_port": {
          "default": 8001,
          "type": "integer"
        },
        "cloud_url": {
          "default": "http://localhost:8000",
          "type": "string"
        },
        "db_path": {
          "default": "var/senseedge.db",
          "type": "string"
        },
        "uplink": {
          "allOf": [
            {
              "$ref": "#/$defs/UplinkConfig"
            }
          ],
          "default": {
            "mode": "http",
            "batch_size": 500,
            "interval_s": 2.0,
            "heartbeat_s": 10.0,
            "max_outbox_rows": 50000,
            "mqtt": {
              "host": "localhost",
              "password": null,
              "port": 1883,
              "session_expiry_s": 604800,
              "username": null,
              "ws_port": 9001
            }
          }
        }
      },
      "required": [
        "device_id",
        "token",
        "edge_port",
        "cloud_url",
        "db_path",
        "uplink"
      ],
      "title": "DeviceConfig",
      "type": "object"
    },
    "Floorplan": {
      "additionalProperties": false,
      "properties": {
        "width_px": {
          "default": 640,
          "type": "integer"
        },
        "height_px": {
          "default": 360,
          "type": "integer"
        },
        "scale_m_per_px": {
          "default": 0.02,
          "type": "number"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "heat_cell_px": {
          "default": 20,
          "type": "integer"
        }
      },
      "title": "Floorplan",
      "type": "object",
      "required": [
        "width_px",
        "height_px",
        "scale_m_per_px",
        "image",
        "heat_cell_px"
      ]
    },
    "HomographyConfig": {
      "additionalProperties": false,
      "description": ">= 4 image/floor point pairs; ``None`` on the camera means identity.",
      "properties": {
        "image_points": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        },
        "floor_points": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "image_points",
        "floor_points"
      ],
      "title": "HomographyConfig",
      "type": "object"
    },
    "ImpactConfig": {
      "additionalProperties": false,
      "properties": {
        "lost_sale_factor": {
          "default": 0.31,
          "type": "number"
        },
        "lost_sale_source": {
          "default": "Gruen, Corsten & Bharadwaj 2002 (GMA/FMI, 71k shoppers, 29 countries): 31% buy elsewhere, 9% abandon",
          "type": "string"
        },
        "queue_abandon_factor": {
          "default": 0.32,
          "type": "number"
        },
        "queue_abandon_source": {
          "default": "Retail queue studies: 32% abandon after long lines; tolerance 5-8 min",
          "type": "string"
        },
        "atv_inr": {
          "default": 180.0,
          "type": "number"
        },
        "baseline_unattended_gap_min": {
          "default": 120.0,
          "type": "number"
        }
      },
      "title": "ImpactConfig",
      "type": "object",
      "required": [
        "lost_sale_factor",
        "lost_sale_source",
        "queue_abandon_factor",
        "queue_abandon_source",
        "atv_inr",
        "baseline_unattended_gap_min"
      ]
    },
    "IntegrationsConfig": {
      "additionalProperties": false,
      "properties": {
        "tally": {
          "allOf": [
            {
              "$ref": "#/$defs/TallyConfig"
            }
          ],
          "default": {
            "enabled": false,
            "url": "http://localhost:9000",
            "company": null
          }
        },
        "ondc": {
          "allOf": [
            {
              "$ref": "#/$defs/OndcConfig"
            }
          ],
          "default": {
            "enabled": false,
            "gateway_url": "http://localhost:8000/mock/ondc",
            "bpp_id": "demo.bpp",
            "signing": "none"
          }
        },
        "whatsapp": {
          "allOf": [
            {
              "$ref": "#/$defs/WhatsAppConfig"
            }
          ],
          "default": {
            "mode": "simulator",
            "to": null,
            "phone_number_id": null,
            "token_env": "WHATSAPP_TOKEN",
            "telegram_chat_id": null,
            "telegram_token_env": "TELEGRAM_TOKEN"
          }
        }
      },
      "title": "IntegrationsConfig",
      "type": "object",
      "required": [
        "tally",
        "ondc",
        "whatsapp"
      ]
    },
    "Lang": {
      "enum": [
        "hi",
        "en"
      ],
      "title": "Lang",
      "type": "string"
    },
    "Line": {
      "additionalProperties": false,
      "description": "Directed line; +1 side (left of start->end, y down) is IN. See geometry.py.",
